{
  "manifest": {
    "name": "EList",
    "id": "ermos.elist",
    "version": "2.0",
    "iconBase64": "data:image/svg+xml;base64,",
    "description": "EList — установка приложений с проверкой подписи",
    "permissions": []
  },
  "html": "<!doctype html><html><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><title>EList</title><style>*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{height:100%;overflow-y:auto;background:#0d1117;color:#c9d1d9;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;padding:24px 20px}.head{font-size:22px;font-weight:700;margin-bottom:4px;color:#fff}.sub{font-size:12px;color:#8b949e;margin-bottom:20px}.box{background:#161b22;border:1px solid #30363d;border-radius:12px;padding:16px;margin-bottom:16px}.box h3{font-size:13px;font-weight:600;color:#8b949e;margin-bottom:12px;text-transform:uppercase;letter-spacing:0.5px}.box textarea{width:100%;min-height:120px;background:#0d1117;border:1px solid #30363d;border-radius:8px;color:#c9d1d9;padding:10px;font-family:ui-monospace,monospace;font-size:11px;resize:vertical;outline:none;line-height:1.4}.box textarea:focus{border-color:#58a6ff}.box button{width:100%;padding:12px;border:0;border-radius:8px;background:#21262d;color:#c9d1d9;font-size:14px;font-weight:600;cursor:pointer;margin-top:8px;transition:background 0.15s}.box button:hover{background:#30363d}.box button.primary{background:#238636;color:#fff}.box button.primary:hover{background:#2ea043}.box button.danger{background:#da3633;color:#fff}.log{background:#0d1117;border:1px solid #30363d;border-radius:12px;padding:12px;font-family:ui-monospace,monospace;font-size:11px;line-height:1.6;color:#8b949e;max-height:220px;overflow-y:auto}.log .ok{color:#3fb950}.log .err{color:#f85149}.log .info{color:#58a6ff}.log .dim{color:#484f58}</style><body><div class=\"head\">EList</div><div class=\"sub\">Install apps with signature check</div><div class=\"box\"><h3>Paste .ermapp code</h3><textarea id=\"codeInput\" placeholder='{\"manifest\":{\"name\":\"App\",\"id\":\"app.id\"},\"html\":\"...\"}'></textarea><button id=\"installBtn\" class=\"primary\">Check & Install</button><button id=\"refreshBtn\">Refresh List.txt</button></div><div class=\"log\" id=\"logBox\"><div class=\"dim\">Loading official list...</div></div><script>(function(){var API='ermos-dev-api-v1',reqId=0;var LIST_URL='https://raw.githubusercontent.com/Olegerorr/ermOS/refs/heads/main/List.txt';var allowlist=[];function call(action,payload){return new Promise(function(resolve){var id='elist-'+Date.now()+'-'+(++reqId);var h=function(e){var d=e.data;if(d&&d.channel===API&&d.type==='response'&&d.requestId===id){window.removeEventListener('message',h);resolve(d)}};window.addEventListener('message',h);try{parent.postMessage({channel:API,type:'request',requestId:id,action:action,payload:payload||{}},'*')}catch(e){resolve({ok:false,error:'send failed'})}setTimeout(function(){window.removeEventListener('message',h);resolve({ok:false,error:'timeout'})},10000)})}function log(msg,cls){var box=document.getElementById('logBox');var line=document.createElement('div');line.className=cls||'dim';line.textContent=msg;box.appendChild(line);box.scrollTop=box.scrollHeight}async function loadList(){log('fetching List.txt...','info');try{var res=await fetch(LIST_URL);if(!res.ok)throw new Error('HTTP '+res.status);var text=await res.text();allowlist=text.split(/\r?\n/).map(function(l){return l.trim()}).filter(function(l){return l&&!l.startsWith('#')});log('loaded '+allowlist.length+' entries','ok')}catch(e){log('failed: '+e.message,'err')}}function findOfficial(manifest){var name=String(manifest.name||'').toLowerCase();var bundle=String(manifest.id||'').toLowerCase();for(var i=0;i<allowlist.length;i++){var line=allowlist[i];var parts=line.includes('|')?line.split('|').map(function(x){return x.trim()}).filter(Boolean):line.split(/\s+/).filter(Boolean);var offName=(parts[0]||'').toLowerCase();var bundleToken=parts.find(function(p){return /^ermapp\./i.test(p)})||parts[1]||'';var offBundle=bundleToken.replace(/^ermapp\./i,'').toLowerCase();var offBundleFull=bundleToken.toLowerCase();if(offName===name||offBundle===bundle||offBundleFull===bundle){return {name:parts[0],bundle:parts[1]||bundleToken}}}return null}async function install(){var raw=document.getElementById('codeInput').value.trim();if(!raw){log('no code provided','err');return}var parsed;try{parsed=JSON.parse(raw)}catch(e){log('invalid JSON: '+e.message,'err');return}if(!parsed.manifest||!parsed.html){log('missing manifest or html','err');return}log('checking signature for '+parsed.manifest.name+'...','info');var official=findOfficial(parsed.manifest);if(official){log('  found official: '+official.name+' ('+official.bundle+')','ok');parsed.manifest.name=official.name;parsed.manifest.id=official.bundle;log('  signature replaced with official','ok')}else{log('  no official signature found, installing as-is','info')}log('installing...','info');var res=await call('createApp',{name:parsed.manifest.name,bundleId:parsed.manifest.id,html:parsed.html,iconBase64:parsed.manifest.iconBase64||''});if(res.ok){log('  installed successfully','ok')}else{log('  failed: '+res.error,'err')}}document.getElementById('installBtn').onclick=install;document.getElementById('refreshBtn').onclick=loadList;loadList()})();</script></body></html>"
}
