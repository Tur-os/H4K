 {
  "manifest": {
    "name": "Qsettings",
    "id": "ermos.qsettings",
    "version": "1.2",
    "iconBase64": "",
    "description": "Advanced Settings by Hack4King ERM Studio",
    "permissions": []
  },
  "html": "<!doctype html><html><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><title>Qsettings</title><style>*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{height:100%;overflow-y:auto;background:linear-gradient(160deg,#006a60 0%,#00453e 100%);color:#fff;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;padding:30px 20px}.header{margin-bottom:24px}.title{font-size:38px;font-weight:800;letter-spacing:-1px;margin-bottom:8px}.subtitle{font-size:14px;color:#a0d8ce;line-height:1.4}.menu{background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border-radius:16px;overflow:hidden;margin-bottom:20px}.menu-item{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid rgba(255,255,255,0.05);cursor:pointer;transition:background 0.2s}.menu-item:last-child{border-bottom:none}.menu-item:active{background:rgba(255,255,255,0.05)}.menu-item .left{display:flex;align-items:center;gap:12px;font-size:16px}.menu-item .icon{font-size:20px;opacity:0.8}.menu-item .arrow{opacity:0.5;font-size:18px}.panel{background:rgba(0,0,0,0.2);border-radius:16px;padding:16px;margin-bottom:16px;display:none}.panel.open{display:block}.panel h3{font-size:14px;margin-bottom:12px;opacity:0.8}.panel label{display:block;font-size:13px;margin-bottom:6px;opacity:0.9}.panel input[type=\"text\"],.panel input[type=\"number\"],.panel select{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.2);background:rgba(0,0,0,0.2);color:#fff;margin-bottom:10px;font-size:14px}.panel input[type=\"range\"]{width:100%;margin-bottom:10px}.panel button{width:100%;padding:12px;border:0;border-radius:8px;background:rgba(255,255,255,0.2);color:#fff;font-size:14px;font-weight:600;cursor:pointer;margin-bottom:8px}.panel button:active{background:rgba(255,255,255,0.3)}.panel .danger{background:rgba(255,69,58,0.6)}.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);z-index:100;display:none;align-items:center;justify-content:center;padding:20px}.modal-overlay.open{display:flex}.modal-content{background:rgba(30,30,30,0.95);border-radius:20px;width:100%;max-width:340px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);max-height:80vh;display:flex;flex-direction:column}.modal-header{padding:16px;text-align:center;font-size:16px;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.1)}.modal-list{padding:10px;display:flex;flex-direction:column;gap:8px;overflow-y:auto}.app-select-btn{display:flex;align-items:center;gap:14px;padding:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:#fff;cursor:pointer;text-align:left}.app-select-btn:active{background:rgba(255,255,255,0.1)}.app-select-btn img{width:36px;height:36px;border-radius:8px;object-fit:cover}.app-select-btn .name{font-size:14px;font-weight:600}.modal-footer{padding:12px;text-align:center;border-top:1px solid rgba(255,255,255,0.1)}.modal-footer button{background:transparent;border:0;color:#0a84ff;font-size:14px;font-weight:600;cursor:pointer}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.8);color:#fff;padding:10px 20px;border-radius:20px;font-size:14px;z-index:200;opacity:0;transition:opacity 0.3s;pointer-events:none}.toast.show{opacity:1}</style><body><div class=\"header\"><div class=\"title\">Qsettings</div><div class=\"subtitle\">Advanced Settings by Hack4King ERM Studio</div></div><div class=\"menu\"><div class=\"menu-item\" id=\"btnIcon\"><div class=\"left\"><span class=\"icon\">🖼️</span> Change App Icon</div><span class=\"arrow\">›</span></div><div class=\"menu-item\" id=\"btnFont\"><div class=\"left\"><span class=\"icon\">🔤</span> Change Font</div><span class=\"arrow\">›</span></div><div class=\"menu-item\" id=\"btnHide\"><div class=\"left\"><span class=\"icon\">👁️</span> Hide Elements</div><span class=\"arrow\">›</span></div><div class=\"menu-item\" id=\"btnBg\"><div class=\"left\"><span class=\"icon\">🎨</span> Change Background</div><span class=\"arrow\">›</span></div><div class=\"menu-item\" id=\"btnTrans\"><div class=\"left\"><span class=\"icon\">💧</span> Transparency</div><span class=\"arrow\">›</span></div><div class=\"menu-item\" id=\"btnBrightness\"><div class=\"left\"><span class=\"icon\">☀️</span> Brightness</div><span class=\"arrow\">›</span></div><div class=\"menu-item\" id=\"btnRestart\"><div class=\"left\"><span class=\"icon\">🔄</span> Restart SpringBoard</div><span class=\"arrow\">›</span></div></div><div class=\"panel\" id=\"panelIcon\"><h3>Change App Icon</h3><button id=\"selectAppForIcon\" style=\"margin-bottom:10px\">Select App</button><label>Base64 Icon:</label><input type=\"text\" id=\"iconBase64Input\" placeholder=\"data:image/png;base64,...\"><button id=\"applyIcon\">Apply Icon</button></div><div class=\"panel\" id=\"panelFont\"><h3>Change Font</h3><label>Font Family:</label><input type=\"text\" id=\"fontInput\" placeholder=\"e.g. Comic Sans MS\"><button id=\"applyFont\">Apply Font</button></div><div class=\"panel\" id=\"panelHide\"><h3>Hide Elements</h3><label>CSS Selector to Hide:</label><input type=\"text\" id=\"hideInput\" placeholder=\"e.g. #erm-ios-v2 .dock\"><button id=\"applyHide\">Hide Element</button><button id=\"resetHide\" class=\"danger\">Reset Hiding</button></div><div class=\"panel\" id=\"panelBg\"><h3>Change Background</h3><label>Color (HEX):</label><input type=\"text\" id=\"bgInput\" placeholder=\"#000000\"><button id=\"applyBg\">Apply Background</button></div><div class=\"panel\" id=\"panelTrans\"><h3>Transparency</h3><label>Transparency (0-1):</label><input type=\"number\" id=\"transInput\" step=\"0.1\" min=\"0\" max=\"1\" value=\"1\"><button id=\"applyTrans\">Apply Transparency</button></div><div class=\"panel\" id=\"panelBrightness\"><h3>Brightness</h3><label>Brightness (0.5 - 1.2):</label><input type=\"range\" id=\"brightnessInput\" step=\"0.05\" min=\"0.5\" max=\"1.2\" value=\"1\"><div style=\"text-align:center;font-size:14px;margin-bottom:10px\"><span id=\"brightnessVal\">1.0</span></div><button id=\"applyBrightness\">Apply Brightness</button></div><div class=\"modal-overlay\" id=\"appModal\"><div class=\"modal-content\"><div class=\"modal-header\">Select App</div><div class=\"modal-list\" id=\"appList\"></div><div class=\"modal-footer\"><button id=\"cancelModal\">Cancel</button></div></div></div><div class=\"toast\" id=\"toast\"></div><script>(function(){var API='ermos-dev-api-v1',reqId=0;function call(action,payload){return new Promise(function(resolve){var id='qset-'+Date.now()+'-'+(++reqId);var h=function(e){var d=e.data;if(d&&d.channel===API&&d.type==='response'&&d.requestId===id){window.removeEventListener('message',h);resolve(d)}};window.addEventListener('message',h);try{parent.postMessage({channel:API,type:'request',requestId:id,action:action,payload:payload||{}},'*')}catch(e){resolve({ok:false,error:'send failed'})}setTimeout(function(){window.removeEventListener('message',h);resolve({ok:false,error:'timeout'})},10000)})}function showToast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2000)}var selectedApp=null;var hiddenSelectors=[];function openPanel(id){document.querySelectorAll('.panel').forEach(function(p){p.classList.remove('open')});var p=document.getElementById(id);if(p)p.classList.add('open')}function rebuildHideCss(){var css='';for(var i=0;i<hiddenSelectors.length;i++){css+=hiddenSelectors[i]+'{display:none!important}';}return css}async function applyHideCss(){var css=rebuildHideCss();var res=await call('setSystemCSS',{css:css});if(res.ok)showToast('Hidden ('+hiddenSelectors.length+')');else showToast('Error: '+res.error)}document.getElementById('btnIcon').onclick=function(){openPanel('panelIcon')};document.getElementById('btnFont').onclick=function(){openPanel('panelFont')};document.getElementById('btnHide').onclick=function(){openPanel('panelHide')};document.getElementById('btnBg').onclick=function(){openPanel('panelBg')};document.getElementById('btnTrans').onclick=function(){openPanel('panelTrans')};document.getElementById('btnBrightness').onclick=function(){openPanel('panelBrightness')};document.getElementById('btnRestart').onclick=function(){showToast('Restarting SpringBoard...');call('setSystemCSS',{css:'body{opacity:0!important;transition:opacity 0.5s}'}).then(function(){setTimeout(function(){call('setSystemCSS',{css:rebuildHideCss()});showToast('SpringBoard restarted');},1000)})};document.getElementById('brightnessInput').oninput=function(){document.getElementById('brightnessVal').textContent=parseFloat(this.value).toFixed(2)};document.getElementById('selectAppForIcon').onclick=async function(){var res=await call('getInstalledApps',{});if(!res.ok||!res.result){showToast('Error: '+(res.error||'unknown'));return}var list=document.getElementById('appList');list.innerHTML='';res.result.forEach(function(app){var btn=document.createElement('button');btn.className='app-select-btn';btn.innerHTML='<img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMjAgMTIwIj48cmVjdCB3aWR0aD0iMTIwIiBoZWlnaHQ9IjEyMCIgcng9IjI3IiBmaWxsPSIjMzQzNDNlIi8+PC9zdmc+\" alt=\"\"><div class=\"name\">'+app.name+'</div>';btn.onclick=function(){selectedApp=app.id;document.getElementById('appModal').classList.remove('open');showToast('Selected: '+app.name)};list.appendChild(btn)});document.getElementById('appModal').classList.add('open')};document.getElementById('cancelModal').onclick=function(){document.getElementById('appModal').classList.remove('open')};document.getElementById('applyIcon').onclick=async function(){if(!selectedApp){showToast('Select an app first');return}var b64=document.getElementById('iconBase64Input').value.trim();if(!b64){showToast('Enter base64 icon');return}var res=await call('setAppIcon',{app:selectedApp,icon:b64});if(res.ok)showToast('Icon applied!');else showToast('Error: '+res.error)};document.getElementById('applyFont').onclick=async function(){var font=document.getElementById('fontInput').value.trim();if(!font){showToast('Enter font name');return}var res=await call('setFont',{family:font});if(res.ok)showToast('Font applied!');else showToast('Error: '+res.error)};document.getElementById('applyHide').onclick=async function(){var sel=document.getElementById('hideInput').value.trim();if(!sel){showToast('Enter CSS selector');return}if(hiddenSelectors.indexOf(sel)===-1){hiddenSelectors.push(sel)}await applyHideCss();document.getElementById('hideInput').value=''};document.getElementById('resetHide').onclick=async function(){hiddenSelectors=[];var res=await call('setSystemCSS',{css:''});if(res.ok)showToast('Hiding reset!');else showToast('Error: '+res.error)};document.getElementById('applyBg').onclick=async function(){var color=document.getElementById('bgInput').value.trim();if(!color){showToast('Enter HEX color');return}var res=await call('setBackground',{color:color});if(res.ok)showToast('Background changed!');else showToast('Error: '+res.error)};document.getElementById('applyTrans').onclick=async function(){var val=parseFloat(document.getElementById('transInput').value);if(isNaN(val)||val<0||val>1){showToast('Enter value 0-1');return}var css='#erm-ios-v2 .screen{opacity:'+val+'!important}';var res=await call('setSystemCSS',{css:css});if(res.ok)showToast('Transparency applied!');else showToast('Error: '+res.error)};document.getElementById('applyBrightness').onclick=async function(){var val=parseFloat(document.getElementById('brightnessInput').value);if(isNaN(val)||val<0.5||val>1.2){showToast('Enter value 0.5-1.2');return}var res=await call('setBrightness',{value:val});if(res.ok)showToast('Brightness: '+val.toFixed(2));else showToast('Error: '+res.error)}})();</script></body></html>"
}