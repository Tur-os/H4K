{
  "manifest": {
    "name": "Snake",
    "id": "ermos.Snake",
    "version": "1.1",
    "iconBase64": "data:image/svg+xml;base64,",
    "description": "EList — лист официальных приложений ermOS",
    "permissions": []
  },
  "html": "<!doctype html><html><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><title>EList</title><style>*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{height:100%;overflow:hidden}body{font-family:-apple-system,system-ui,sans-serif;background:#0b1026;color:#e7ecf5;display:flex;flex-direction:column}.bar{height:54px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:0 14px;background:#0f1630;border-bottom:1px solid #ffffff1a}.bar b{font-size:15px;color:#7fc4ff;font-weight:700}.bar .tools{display:flex;gap:6px}.bar button{border:0;background:#7fc4ff1a;color:#7fc4ff;font-size:12px;font-weight:600;cursor:pointer;padding:7px 10px;border-radius:10px}.bar button:active{background:#7fc4ff33}.content{flex:1;overflow-y:auto;padding:14px}.title{font-size:20px;font-weight:800;color:#fff;margin-bottom:4px;letter-spacing:-.4px}.sub{font-size:11px;color:#8a95ad;margin-bottom:14px}.status{padding:8px 12px;border-radius:10px;background:#151d3a;color:#b8c4e8;font-size:12px;margin-bottom:12px;overflow-wrap:anywhere}.status.err{color:#ffb4ab}.status.ok{color:#7cffc4}.frame-wrap{background:#fff;border-radius:14px;overflow:hidden;border:1px solid #ffffff1a;height:380px;margin-bottom:14px}.frame-wrap iframe{width:100%;height:100%;border:0;background:#fff}.list{display:flex;flex-direction:column;gap:8px}.item{background:#151d3a;border:1px solid #ffffff14;border-radius:12px;padding:12px 14px;display:flex;align-items:center;gap:10px}.item .idx{font-size:11px;font-weight:700;color:#7fc4ff;background:#7fc4ff1a;border-radius:6px;padding:3px 7px;flex-shrink:0}.item .name{flex:1;font-size:14px;font-weight:600;overflow-wrap:anywhere}.item .raw{font-size:10px;color:#8a95ad;overflow-wrap:anywhere;margin-top:4px}.empty{padding:20px;text-align:center;color:#8a95ad;font-size:12px}</style><body><div class=\"bar\"><b>EList</b><div class=\"tools\"><button id=\"reload\">Обновить</button><button id=\"iframeBtn\">iframe</button><button id=\"parseBtn\">Разбор</button></div></div><div class=\"content\" id=\"content\"><div class=\"title\">Лист официальных приложений</div><div class=\"sub\" id=\"sub\"></div><div class=\"status\" id=\"status\">Загрузка…</div><div id=\"view\"></div></div><script>(function(){var URL_LIST='https://raw.githubusercontent.com/Olegerorr/ermOS/refs/heads/main/List.txt';var status=document.getElementById('status'),view=document.getElementById('view'),sub=document.getElementById('sub');function setStatus(t,c){status.textContent=t;status.className='status'+(c?' '+c:'')}function esc(v){return String(v==null?'':v).replace(/[&<>\"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}function showIframe(){setStatus('Режим: iframe — загружаю страницу…');view.innerHTML='<div class=\"frame-wrap\"><iframe sandbox=\"allow-scripts allow-same-origin\" referrerpolicy=\"no-referrer\" src=\"'+URL_LIST+'\"></iframe></div>';var f=view.querySelector('iframe');f.addEventListener('load',function(){setStatus('iframe загружен','ok');sub.textContent='Источник: '+URL_LIST});f.addEventListener('error',function(){setStatus('iframe не загрузился','err')})}async function showParse(){setStatus('Режим: разбор — читаю файл…');view.innerHTML='<div class=\"empty\">Загрузка…</div>';sub.textContent='';try{var res=await fetch(URL_LIST,{cache:'no-store'});if(!res.ok)throw new Error('HTTP '+res.status);var text=await res.text();var lines=text.split(/\\r?\\n/).map(function(x){return x.trim()}).filter(function(x){return x&&!x.startsWith('#')});if(!lines.length){view.innerHTML='<div class=\"empty\">Файл пуст</div>';setStatus('Файл пуст','ok');sub.textContent='Источник: '+URL_LIST;return}var html='<div class=\"list\">';lines.forEach(function(line,i){var parts=line.split('|').map(function(x){return x.trim()});var name=parts[0]||line;html+='<div class=\"item\"><span class=\"idx\">'+(i+1)+'</span><div style=\"flex:1;min-width:0\"><div class=\"name\">'+esc(name)+'</div><div class=\"raw\">'+esc(line)+'</div></div></div>'});html+='</div>';view.innerHTML=html;sub.textContent='Источник: '+URL_LIST;setStatus('Прочитано строк: '+lines.length,'ok')}catch(e){view.innerHTML='<div class=\"empty\">Ошибка: '+esc(e.message)+'</div>';setStatus('Ошибка: '+e.message,'err')}}document.getElementById('reload').onclick=function(){showParse()};document.getElementById('iframeBtn').onclick=showIframe;document.getElementById('parseBtn').onclick=showParse;showParse()})();<\/script></body></html>"
}